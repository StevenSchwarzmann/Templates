{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Mvc": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/template-api_.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SequenceNumber:000000}] [{InstanceId}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=YOUR_SERVER;Initial Catalog=YourDatabase;Integrated Security=true;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "SecondaryConnection": "Data Source=YOUR_SERVER;Initial Catalog=YourSecondaryDatabase;Integrated Security=true;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "AzureKeyVaultSettings": {
    "SecretsKeyVaultUri": ""
  },
  "AllowedHosts": "*"
}
